+void BrowserView::ToggleAISidebar() {
+  if (!ai_sidebar_web_view_) {
+    return;
+  }
+
+  bool is_visible = ai_sidebar_web_view_->GetVisible();
+  ai_sidebar_web_view_->SetVisible(!is_visible);
+  contents_container_->Layout();
+  InvalidateLayout();
+}
