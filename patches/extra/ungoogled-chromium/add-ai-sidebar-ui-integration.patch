@@ -2076,6 +2078,24 @@ void BrowserView::AddedToWidget() {
     loading_bar_ = top_container()->AddChildView(
         std::make_unique<TopContainerLoadingBar>(browser_->profile()));
   }
+
+  // Add AI sidebar if enabled
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("disable-ai-sidebar")) {
+    ai_sidebar_web_view_ = contents_container_->AddChildViewAt(
+        std::make_unique<views::WebView>(browser_->profile()), 1);
+
+    // Set the sidebar width
+    ai_sidebar_web_view_->SetPreferredSize(gfx::Size(400, 0));
+
+    // Load the AI sidebar WebUI
+    ai_sidebar_web_view_->LoadInitialURL(GURL("chrome://ai-sidebar"));
+
+    // Initially hidden
+    ai_sidebar_web_view_->SetVisible(false);
+
+    // Update layout
+    contents_container_->Layout();
+  }
 }

