+  // AI Sidebar is always available
+  command_updater_.UpdateCommandEnabled(
+      IDC_TOGGLE_AI_SIDEBAR,
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("disable-ai-sidebar"));
+
   command_updater_.UpdateCommandEnabled(IDC_SHOW_READING_LIST_SIDE_PANEL,
