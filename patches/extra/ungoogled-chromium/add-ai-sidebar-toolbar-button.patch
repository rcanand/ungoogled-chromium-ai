   }

+  // Add AI Sidebar button
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch("disable-ai-sidebar")) {
+    auto ai_sidebar_button = std::make_unique<ToolbarButton>(
+        base::BindRepeating(&ToolbarView::OnAISidebarButtonPressed,
+                           base::Unretained(this)));
+    ai_sidebar_button->SetTooltipText(u"Toggle AI Chat");
+    ai_sidebar_button->SetAccessibleName(u"AI Chat");
+    ai_sidebar_button->SetVectorIcon(kChatIcon);
+    ai_sidebar_button->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(kChatIcon, kColorToolbarButtonIcon));
+    ai_sidebar_button_ = container->AddChildView(std::move(ai_sidebar_button));
+    LoadImages();
+  }
+
